rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // MINO-SMS Zero-Trust Architecture:
    // Direct client reads and writes to Firestore are completely denied.
    // Every operation is mediated by authoritative, schema-validated Cloud Functions / API endpoints.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
